    <geom condim="4" friction="0.04 0.004 0.0001" solref="0.01 1" solimp="0.99 0.99 0.001" />
    <site rgba="1 0 0 0.35" />
    <default class="probe">
      <joint type="slide" axis="0 0 1" range="0 0.020" springref="0" stiffness="8000" damping="120" />
      <geom type="capsule" size="0.003" density="7800" condim="1" rgba="0.12 0.14 0.16 1" />
      <site type="sphere" size="0.004" rgba="0 0 0 0" />
    </default>
  </default>
  <asset>
    <material name="crampon_metal" rgba="0.16 0.24 0.32 1" metallic="0.8" roughness="0.28" />
    <material name="mount_plate" rgba="0.12 0.12 0.13 1" metallic="0.25" roughness="0.5" />
